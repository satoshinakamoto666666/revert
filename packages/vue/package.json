{
  "name": "@tryabby/vue",
  "version": "1.0.0",
  "description": "Official Vue 3 & Nuxt integration for Abby A/B testing, feature flags, and remote config",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tryabby/core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "tsup": "^7.2.0",
    "typescript": "^5.1.6",
    "vitest": "^0.34.4",
    "vue": "^3.3.4"
  }
}
